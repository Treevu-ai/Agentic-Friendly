{
  "name": "AgenticFriendly · GEO Lead Bot v2 — Captura + Sheets + Notificación",
  "flow": [
    {
      "id": 1,
      "module": "telegram-bot:TriggerNewUpdates",
      "version": 1,
      "parameters": {
        "__IMTCONN__": {
          "data": { "scoped": "true", "connection": "telegram-bot" },
          "label": "agentic_friendly_bot"
        }
      },
      "filter": {
        "name": "Solo mensajes privados de texto",
        "conditions": [
          [
            {
              "a": "{{1.message.chat.type}}",
              "b": "private",
              "o": "text:equal"
            }
          ]
        ]
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "__IMTCONN__": { "label": "agentic_friendly_bot" }
          }
        }
      }
    },
    {
      "id": 2,
      "module": "datastore:ActionSearchRecords",
      "version": 1,
      "parameters": {
        "__IMTCONN__": {
          "data": { "scoped": "true", "connection": "datastore" },
          "label": "GEO_Bot_State"
        },
        "dataStoreId": "GEO_Bot_State"
      },
      "filter": null,
      "mapper": {
        "filter": {
          "conditions": [
            [
              {
                "a": "chat_id",
                "o": "text:equal",
                "b": "{{1.message.chat.id}}"
              }
            ]
          ]
        },
        "limit": "1"
      },
      "metadata": {
        "designer": { "x": 330, "y": 0 },
        "restore": {
          "parameters": {
            "__IMTCONN__": { "label": "GEO_Bot_State" }
          }
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "filter": null,
      "mapper": {},
      "metadata": { "designer": { "x": 660, "y": 0 } },
      "routes": [

        {
          "flow": [
            {
              "id": 4,
              "module": "datastore:ActionAddRecord",
              "version": 1,
              "parameters": {
                "__IMTCONN__": {
                  "data": { "scoped": "true", "connection": "datastore" },
                  "label": "GEO_Bot_State"
                },
                "dataStoreId": "GEO_Bot_State"
              },
              "filter": null,
              "mapper": {
                "key": "{{1.message.chat.id}}",
                "data": {
                  "chat_id": "{{1.message.chat.id}}",
                  "stage": "1",
                  "score": "{{parseNumber(replace(1.message.text, \"/start geo_\", \"\"))}}",
                  "first_name": "{{ifempty(1.message.from.first_name, \"visitante\")}}",
                  "nombre": "",
                  "contacto": "",
                  "horario": ""
                },
                "overwrite": true
              },
              "metadata": { "designer": { "x": 990, "y": -400 } }
            },
            {
              "id": 5,
              "module": "telegram-bot:ActionSendMessage",
              "version": 1,
              "parameters": {
                "__IMTCONN__": {
                  "data": { "scoped": "true", "connection": "telegram-bot" },
                  "label": "agentic_friendly_bot"
                }
              },
              "filter": null,
              "mapper": {
                "chat_id": "{{1.message.chat.id}}",
                "parse_mode": "Markdown",
                "text": "👋 Hola *{{ifempty(1.message.from.first_name, \"visitante\")}}* — vi tu GEO Score: *{{parseNumber(replace(1.message.text, \"/start geo_\", \"\"))}}/100*.\n\nPara enviarte recomendaciones personalizadas y coordinar una revisión, necesito tres datos rápidos.\n\n*¿Cuál es tu nombre completo?*"
              },
              "metadata": { "designer": { "x": 1320, "y": -400 } }
            }
          ],
          "filter": {
            "name": "Nuevo inicio (/start geo_)",
            "conditions": [
              [
                {
                  "a": "{{1.message.text}}",
                  "b": "/start geo_",
                  "o": "text:startswith"
                }
              ]
            ]
          }
        },

        {
          "flow": [
            {
              "id": 6,
              "module": "datastore:ActionUpdateRecord",
              "version": 1,
              "parameters": {
                "__IMTCONN__": {
                  "data": { "scoped": "true", "connection": "datastore" },
                  "label": "GEO_Bot_State"
                },
                "dataStoreId": "GEO_Bot_State"
              },
              "filter": null,
              "mapper": {
                "key": "{{1.message.chat.id}}",
                "data": {
                  "nombre": "{{1.message.text}}",
                  "stage": "2"
                }
              },
              "metadata": { "designer": { "x": 990, "y": -133 } }
            },
            {
              "id": 7,
              "module": "telegram-bot:ActionSendMessage",
              "version": 1,
              "parameters": {
                "__IMTCONN__": {
                  "data": { "scoped": "true", "connection": "telegram-bot" },
                  "label": "agentic_friendly_bot"
                }
              },
              "filter": null,
              "mapper": {
                "chat_id": "{{1.message.chat.id}}",
                "parse_mode": "Markdown",
                "text": "Perfecto, *{{1.message.text}}* 👍\n\n*¿Cuál es tu WhatsApp o email?*\n_(el que prefieras para coordinar)_"
              },
              "metadata": { "designer": { "x": 1320, "y": -133 } }
            }
          ],
          "filter": {
            "name": "Stage 1 — esperando nombre",
            "conditions": [
              [
                {
                  "a": "{{2.stage}}",
                  "b": "1",
                  "o": "text:equal"
                },
                {
                  "a": "{{1.message.text}}",
                  "b": "/start",
                  "o": "text:notstartswith"
                }
              ]
            ]
          }
        },

        {
          "flow": [
            {
              "id": 8,
              "module": "datastore:ActionUpdateRecord",
              "version": 1,
              "parameters": {
                "__IMTCONN__": {
                  "data": { "scoped": "true", "connection": "datastore" },
                  "label": "GEO_Bot_State"
                },
                "dataStoreId": "GEO_Bot_State"
              },
              "filter": null,
              "mapper": {
                "key": "{{1.message.chat.id}}",
                "data": {
                  "contacto": "{{1.message.text}}",
                  "stage": "3"
                }
              },
              "metadata": { "designer": { "x": 990, "y": 133 } }
            },
            {
              "id": 9,
              "module": "telegram-bot:ActionSendMessage",
              "version": 1,
              "parameters": {
                "__IMTCONN__": {
                  "data": { "scoped": "true", "connection": "telegram-bot" },
                  "label": "agentic_friendly_bot"
                }
              },
              "filter": null,
              "mapper": {
                "chat_id": "{{1.message.chat.id}}",
                "parse_mode": "Markdown",
                "text": "Anotado ✅\n\n*¿Cuál es tu horario preferido para que te contactemos?*\n\n· Mañanas (8–12h)\n· Tardes (12–18h)\n· Noches (18–21h)"
              },
              "metadata": { "designer": { "x": 1320, "y": 133 } }
            }
          ],
          "filter": {
            "name": "Stage 2 — esperando contacto",
            "conditions": [
              [
                {
                  "a": "{{2.stage}}",
                  "b": "2",
                  "o": "text:equal"
                },
                {
                  "a": "{{1.message.text}}",
                  "b": "/start",
                  "o": "text:notstartswith"
                }
              ]
            ]
          }
        },

        {
          "flow": [
            {
              "id": 10,
              "module": "datastore:ActionUpdateRecord",
              "version": 1,
              "parameters": {
                "__IMTCONN__": {
                  "data": { "scoped": "true", "connection": "datastore" },
                  "label": "GEO_Bot_State"
                },
                "dataStoreId": "GEO_Bot_State"
              },
              "filter": null,
              "mapper": {
                "key": "{{1.message.chat.id}}",
                "data": {
                  "horario": "{{1.message.text}}",
                  "stage": "4"
                }
              },
              "metadata": { "designer": { "x": 990, "y": 400 } }
            },
            {
              "id": 11,
              "module": "google-sheets:ActionAddRow",
              "version": 1,
              "parameters": {
                "__IMTCONN__": {
                  "data": { "scoped": "true", "connection": "google" },
                  "label": "Google Sheets"
                },
                "spreadsheetId": "REEMPLAZAR_CON_ID_DE_SHEET",
                "sheetId": "GEO_Leads"
              },
              "filter": null,
              "mapper": {
                "values": {
                  "Fecha": "{{formatDate(now, \"DD/MM/YYYY HH:mm\")}}",
                  "Nombre": "{{2.nombre}}",
                  "Contacto": "{{2.contacto}}",
                  "Horario": "{{1.message.text}}",
                  "GEO Score": "{{2.score}}",
                  "Telegram": "{{2.first_name}}",
                  "Chat ID": "{{1.message.chat.id}}"
                }
              },
              "metadata": { "designer": { "x": 1320, "y": 300 } }
            },
            {
              "id": 12,
              "module": "gmail:ActionSendEmail",
              "version": 1,
              "parameters": {
                "__IMTCONN__": {
                  "data": { "scoped": "true", "connection": "google" },
                  "label": "sinapsisinnovadoraperu@gmail.com"
                }
              },
              "filter": null,
              "mapper": {
                "to": "sinapsisinnovadoraperu@gmail.com",
                "subject": "🎯 Nuevo lead GEO Score — {{2.nombre}} ({{2.score}}/100)",
                "content": "<h2>Nuevo lead desde Agentic Friendly Bot</h2><table><tr><td><b>Nombre</b></td><td>{{2.nombre}}</td></tr><tr><td><b>Contacto</b></td><td>{{2.contacto}}</td></tr><tr><td><b>Horario preferido</b></td><td>{{1.message.text}}</td></tr><tr><td><b>GEO Score</b></td><td>{{2.score}}/100</td></tr><tr><td><b>Telegram</b></td><td>@{{2.first_name}}</td></tr><tr><td><b>Fecha</b></td><td>{{formatDate(now, \"DD/MM/YYYY HH:mm\")}}</td></tr></table>",
                "contentType": "html"
              },
              "metadata": { "designer": { "x": 1320, "y": 400 } }
            },
            {
              "id": 13,
              "module": "telegram-bot:ActionSendMessage",
              "version": 1,
              "parameters": {
                "__IMTCONN__": {
                  "data": { "scoped": "true", "connection": "telegram-bot" },
                  "label": "agentic_friendly_bot"
                }
              },
              "filter": null,
              "mapper": {
                "chat_id": "{{1.message.chat.id}}",
                "parse_mode": "Markdown",
                "text": "✅ *¡Listo, {{2.nombre}}!*\n\nRicardo te contactará en tu horario preferido: *{{1.message.text}}*.\n\nMientras tanto, revisa las recomendaciones del reporte que descargaste — ya tienes las acciones prioritarias identificadas.\n\nHasta pronto 🚀"
              },
              "metadata": { "designer": { "x": 1320, "y": 500 } }
            }
          ],
          "filter": {
            "name": "Stage 3 — esperando horario",
            "conditions": [
              [
                {
                  "a": "{{2.stage}}",
                  "b": "3",
                  "o": "text:equal"
                },
                {
                  "a": "{{1.message.text}}",
                  "b": "/start",
                  "o": "text:notstartswith"
                }
              ]
            ]
          }
        }

      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us2.make.com"
  }
}
